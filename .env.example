# Copy to .env.local and fill in. Values live in the Supabase dashboard.

# App runtime (also set these two in Vercel)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Supabase CLI only (migrations + type generation, never shipped)
SUPABASE_ACCESS_TOKEN=sbp_...
SUPABASE_DB_PASSWORD=...

# Claude drafts (server only, never NEXT_PUBLIC)
ANTHROPIC_API_KEY=sk-ant-...
